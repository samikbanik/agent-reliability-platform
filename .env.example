# Runtime
APP_ENV=development
LOG_LEVEL=INFO

# Public web configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Service addresses
API_HOST=0.0.0.0
API_PORT=8000
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8001
ORCHESTRATOR_URL=http://localhost:8001

# Local data services (introduced in Phase 1)
POSTGRES_DB=agent_reliability
POSTGRES_USER=agent_reliability
POSTGRES_PASSWORD=agent_reliability
DATABASE_URL=postgresql+psycopg://agent_reliability:agent_reliability@localhost:5432/agent_reliability
REDIS_URL=redis://localhost:6379/0
RABBITMQ_DEFAULT_USER=agent_reliability
RABBITMQ_DEFAULT_PASS=agent_reliability
RABBITMQ_URL=amqp://agent_reliability:agent_reliability@localhost:5672/

# Artifact storage (local filesystem for the MVP)
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_STORAGE_PATH=.data/artifacts

# Model provider (leave blank until an integration is selected)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Telemetry (enabled in Phase 3)
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
